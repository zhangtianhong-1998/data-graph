{
  "$defs": {
    "ColumnEndpoint": {
      "additionalProperties": false,
      "description": "A fixed column object attached only to observed rows of its own table.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "evidence_refs": {
          "description": "Issued metadata or applicable document references supporting this column meaning; never raw values or invented evidence IDs.",
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "table",
        "column",
        "evidence_refs"
      ],
      "title": "ColumnEndpoint",
      "type": "object"
    },
    "EndpointLookup": {
      "additionalProperties": false,
      "description": "Resolve one endpoint through actual equal-key matches in an authorized table.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typed Predicate/1.0 filter: is_not_null/is_null have no value, ne uses value; logical all/any/not (and alias). Read reference:predicate-guide.md. No raw SQL.",
          "title": "Predicate"
        },
        "match_columns": {
          "description": "Columns matched to the corresponding relation key_columns, in order. Include tenant or other required matching scope explicitly.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Match Columns",
          "type": "array"
        },
        "key_columns": {
          "description": "Columns from the matched row that form the resolved entity identity.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Key Columns",
          "type": "array"
        },
        "cardinality": {
          "default": "one",
          "description": "one rejects matches to multiple distinct endpoint identities; many explicitly permits all observed matches for this input row.",
          "enum": [
            "one",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "on_missing": {
          "default": "error",
          "description": "error diagnoses unmatched references; omit explicitly omits unmatched input rows and reports their count.",
          "enum": [
            "error",
            "omit"
          ],
          "title": "On Missing",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "table",
        "match_columns",
        "key_columns"
      ],
      "title": "EndpointLookup",
      "type": "object"
    },
    "EntityDefinition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "key_names": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Key Names",
          "type": "array"
        },
        "mappings": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/EntityMapping"
              },
              {
                "$ref": "#/$defs/MetadataColumnMapping"
              }
            ]
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Mappings",
          "type": "array"
        },
        "display_mode": {
          "default": "auto",
          "description": "For objects without a source label: derive from visible relations or the complete identity. Explicit source labels always take precedence.",
          "enum": [
            "auto",
            "identity",
            "relations"
          ],
          "title": "Display Mode",
          "type": "string"
        }
      },
      "required": [
        "type",
        "key_names",
        "mappings"
      ],
      "title": "EntityDefinition",
      "type": "object"
    },
    "EntityMapping": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typed Predicate/1.0 filter: is_not_null/is_null have no value, ne uses value; logical all/any/not (and alias). Read reference:predicate-guide.md. No raw SQL.",
          "title": "Predicate"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "title": "Properties"
        },
        "constant_properties": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Agent-declared mapping annotations, such as the observed slot or endpoint positions. Not identity keys or source-verified values.",
          "maxProperties": 32,
          "title": "Constant Properties",
          "type": "object"
        },
        "context_columns": {
          "description": "Authorized columns that identify a source-row context shared across mappings. Retained on each support, never added to entity identity. Use the same column set for related mappings.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Context Columns",
          "type": "array"
        },
        "kind": {
          "const": "row",
          "default": "row",
          "title": "Kind",
          "type": "string"
        },
        "key_columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Key Columns",
          "type": "array"
        },
        "label_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical column containing the primary source name (e.g. Chinese name). Choose a confirmed name column when available; omission generates a display/identity fallback and does not check name consistency. Never omit a known name to bypass a conflict.",
          "title": "Label Column"
        },
        "english_name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical column containing a confirmed English name for this object. Leave null if absent; never guess from aliases.",
          "title": "English Name Column"
        },
        "description_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical column containing row-level object description text. Distinct from database catalog comments.",
          "title": "Description Column"
        },
        "alias_columns": {
          "description": "Confirmed alternate names, translations or abbreviations for the same object. Display columns alone do not become aliases.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Alias Columns",
          "type": "array"
        },
        "display_columns": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Supplementary display components, or a composite display for objects without an independent name. Does not replace label_column or alias_columns and never changes identity.",
          "maxProperties": 32,
          "title": "Display Columns",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "table",
        "key_columns"
      ],
      "title": "EntityMapping",
      "type": "object"
    },
    "MetadataColumnMapping": {
      "additionalProperties": false,
      "description": "One authorized catalog column as a physical semantic object, not its values.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "evidence_refs": {
          "description": "Issued metadata or applicable document references supporting this column meaning; never raw values or invented evidence IDs.",
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "const": "metadata_column",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent-declared primary meaning supported by evidence. If omitted, catalog comment then physical column name is used; no fact values are read.",
          "title": "Label"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Aliases",
          "type": "array"
        },
        "semantic_annotations": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Evidence-backed Agent interpretations; recorded as declared annotations, separately from observed catalog metadata.",
          "maxProperties": 32,
          "title": "Semantic Annotations",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "table",
        "column",
        "evidence_refs",
        "kind"
      ],
      "title": "MetadataColumnMapping",
      "type": "object"
    },
    "RelationDefinition": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "source_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        },
        "target_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Target Type",
          "type": "string"
        },
        "allow_self_links": {
          "default": false,
          "title": "Allow Self Links",
          "type": "boolean"
        },
        "acyclic": {
          "default": false,
          "title": "Acyclic",
          "type": "boolean"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/RelationMapping"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Mappings",
          "type": "array"
        }
      },
      "required": [
        "type",
        "source_type",
        "target_type",
        "mappings"
      ],
      "title": "RelationDefinition",
      "type": "object"
    },
    "RelationMapping": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "predicate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typed Predicate/1.0 filter: is_not_null/is_null have no value, ne uses value; logical all/any/not (and alias). Read reference:predicate-guide.md. No raw SQL.",
          "title": "Predicate"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 128,
          "title": "Properties"
        },
        "constant_properties": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "description": "Agent-declared mapping annotations, such as the observed slot or endpoint positions. Not identity keys or source-verified values.",
          "maxProperties": 32,
          "title": "Constant Properties",
          "type": "object"
        },
        "context_columns": {
          "description": "Authorized columns that identify a source-row context shared across mappings. Retained on each support, never added to entity identity. Use the same column set for related mappings.",
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Context Columns",
          "type": "array"
        },
        "source_key_columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Source Key Columns",
          "type": "array"
        },
        "target_key_columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Target Key Columns",
          "type": "array"
        },
        "source_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnEndpoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metadata_basis": {
          "anyOf": [
            {
              "enum": [
                "schema_applies_to_rows",
                "observed_non_null"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for a column endpoint. schema_applies_to_rows declares applicability to actual selected rows using evidence; observed_non_null restricts rows by that physical column IS NOT NULL without retaining its values. NULL absence never proves non-applicability.",
          "title": "Metadata Basis"
        },
        "source_lookup": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointLookup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_lookup": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointLookup"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "equal_endpoints": {
          "default": "error",
          "enum": [
            "error",
            "omit",
            "include"
          ],
          "title": "Equal Endpoints",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "table"
      ],
      "title": "RelationMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
    },
    "purpose": {
      "default": "",
      "maxLength": 4000,
      "title": "Purpose",
      "type": "string"
    },
    "extends_base_graph": {
      "default": false,
      "description": "Whether this incremental draft references entity types inherited from a frozen base graph.",
      "title": "Extends Base Graph",
      "type": "boolean"
    },
    "inherited_entity_types": {
      "description": "Explicitly inherited entity type names available as relation endpoints without re-scanning old sources.",
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Inherited Entity Types",
      "type": "array"
    },
    "inherited_entity_key_arities": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Optional expected identity key arity per inherited entity type.",
      "maxProperties": 128,
      "title": "Inherited Entity Key Arities",
      "type": "object"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityDefinition"
      },
      "maxItems": 128,
      "title": "Entities",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/RelationDefinition"
      },
      "maxItems": 128,
      "title": "Relations",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 512,
      "title": "Evidence Refs",
      "type": "array"
    },
    "rationale": {
      "default": "",
      "maxLength": 8000,
      "title": "Rationale",
      "type": "string"
    },
    "unresolved": {
      "description": "Only unmet requirements of the current user goal. Empty when covered; never invent missing work.",
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Unresolved",
      "type": "array"
    },
    "decisions": {
      "description": "Evidence-backed choices already applied; these do not prevent completion.",
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Decisions",
      "type": "array"
    },
    "suggestions": {
      "description": "Optional future improvements outside the current goal; these do not prevent completion.",
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Suggestions",
      "type": "array"
    }
  },
  "required": [
    "draft_id"
  ],
  "title": "GraphDraft",
  "type": "object"
}