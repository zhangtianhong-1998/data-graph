{
  "$defs": {
    "EntityTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "EntityTypeDefinition",
      "type": "object"
    },
    "ExtractionGoal": {
      "additionalProperties": false,
      "description": "Operator intent and output scope; these never grant source permissions.",
      "properties": {
        "target": {
          "const": "graph",
          "default": "graph",
          "title": "Target",
          "type": "string"
        },
        "goal_id": {
          "default": "user_graph",
          "title": "Goal Id",
          "type": "string"
        },
        "purpose": {
          "default": "根据用户目的，从授权数据和材料中发现相关对象、属性及关系并构建图谱。",
          "maxLength": 4000,
          "title": "Purpose",
          "type": "string"
        },
        "include": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Include",
          "type": "array"
        },
        "exclude": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Exclude",
          "type": "array"
        },
        "discovery_guidance": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Discovery Guidance",
          "type": "array"
        },
        "runtime_guidance": {
          "items": {
            "$ref": "#/$defs/RuntimeGuidance"
          },
          "maxItems": 16,
          "title": "Runtime Guidance",
          "type": "array"
        },
        "entity_kinds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Entity Kinds",
          "type": "array"
        },
        "relation_kinds": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 128,
          "title": "Relation Kinds",
          "type": "array"
        },
        "source_scope": {
          "items": {
            "type": "string"
          },
          "title": "Source Scope",
          "type": "array"
        },
        "excluded_columns": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Columns",
          "type": "array"
        },
        "evidence_only_columns": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Only Columns",
          "type": "array"
        },
        "observation_values": {
          "default": false,
          "title": "Observation Values",
          "type": "boolean"
        },
        "semantic_schema": {
          "$ref": "#/$defs/SemanticSchema"
        }
      },
      "title": "ExtractionGoal",
      "type": "object"
    },
    "GraphScopeBinding": {
      "additionalProperties": false,
      "description": "Operator-owned visibility mapping; never accepted from an Agent draft.",
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "schema": {
          "default": "public",
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "table"
      ],
      "title": "GraphScopeBinding",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "metadata_only",
            "in_environment",
            "approved_external"
          ],
          "title": "Mode",
          "type": "string"
        },
        "base_url": {
          "default": "",
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "response_format": {
          "default": "json_schema",
          "enum": [
            "json_schema",
            "json_object"
          ],
          "title": "Response Format",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "api_key_env": {
          "default": "LIGHTGRAPH_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "stream_options_include_usage": {
          "default": true,
          "title": "Stream Options Include Usage",
          "type": "boolean"
        },
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "max_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 40,
          "title": "Max Calls"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy cumulative-token setting retained for configuration migration; Harness budgets physical calls and wall time.",
          "title": "Max Tokens"
        },
        "max_discovery_steps": {
          "default": 16,
          "description": "Legacy per-table setting, accepted when reading old configurations; not used by Harness.",
          "maximum": 32,
          "minimum": 1,
          "title": "Max Discovery Steps",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 16,
          "description": "Legacy source-tool allowance; not used by Harness.",
          "maximum": 64,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 4096,
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_prompt_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy request-byte guard retained for configuration migration; not applied by Harness.",
          "title": "Max Prompt Bytes"
        },
        "max_prompt_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional estimated input token cap, including tool schemas; independent of byte limits.",
          "title": "Max Prompt Tokens"
        },
        "context_window_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional combined input/output token window; max_output_tokens is reserved from it.",
          "title": "Context Window Tokens"
        },
        "working_context_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 32768,
          "description": "Harness working-context target; null disables automatic compaction including overflow recovery. Token-meter estimates are calibrated from provider usage.",
          "title": "Working Context Tokens"
        },
        "max_response_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy response-byte guard retained for configuration migration; not applied by Harness.",
          "title": "Max Response Bytes"
        },
        "retries": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    },
    "PropertyDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "value_type": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "entity_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Entity Kinds",
          "type": "array"
        },
        "multi_valued": {
          "default": false,
          "title": "Multi Valued",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "entity_kinds"
      ],
      "title": "PropertyDefinition",
      "type": "object"
    },
    "QueryLimits": {
      "additionalProperties": false,
      "properties": {
        "max_batch_rows": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "title": "Max Batch Rows",
          "type": "integer"
        },
        "max_batch_bytes": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "title": "Max Batch Bytes",
          "type": "integer"
        },
        "max_result_rows": {
          "default": 20000,
          "exclusiveMinimum": 0,
          "title": "Max Result Rows",
          "type": "integer"
        },
        "max_result_bytes": {
          "default": 16777216,
          "exclusiveMinimum": 0,
          "title": "Max Result Bytes",
          "type": "integer"
        },
        "timeout_ms": {
          "default": 60000,
          "exclusiveMinimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "title": "QueryLimits",
      "type": "object"
    },
    "RelationDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Kinds",
          "type": "array"
        },
        "target_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Target Kinds",
          "type": "array"
        },
        "allow_self_links": {
          "default": false,
          "description": "Whether an object may relate to itself. False unless explicitly permitted by the business meaning and independently reviewed; matching endpoint values alone never grant this permission.",
          "title": "Allow Self Links",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "source_kinds",
        "target_kinds"
      ],
      "title": "RelationDefinition",
      "type": "object"
    },
    "RuntimeGuidance": {
      "additionalProperties": false,
      "description": "Explicit operator instructions, selected for each ephemeral Agent call.",
      "properties": {
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "injection": {
          "default": "global",
          "enum": [
            "global",
            "task",
            "iteration",
            "semantic_review"
          ],
          "title": "Injection",
          "type": "string"
        },
        "stages": {
          "items": {
            "enum": [
              "T0_discovery",
              "T1_table_discovery",
              "T2_cross_table",
              "T3_hierarchy",
              "T4_document",
              "T5_revision",
              "semantic_review"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "RuntimeGuidance",
      "type": "object"
    },
    "SemanticSchema": {
      "additionalProperties": false,
      "properties": {
        "entity_types": {
          "items": {
            "$ref": "#/$defs/EntityTypeDefinition"
          },
          "maxItems": 64,
          "title": "Entity Types",
          "type": "array"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyDefinition"
          },
          "maxItems": 256,
          "title": "Properties"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDefinition"
          },
          "maxItems": 128,
          "title": "Relations",
          "type": "array"
        }
      },
      "title": "SemanticSchema",
      "type": "object"
    },
    "SourceConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "excel_workbook",
            "csv_file",
            "gauss_database",
            "mysql_database"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "dsn_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dsn Env"
        },
        "credential_mode": {
          "default": "environment",
          "enum": [
            "environment",
            "session"
          ],
          "title": "Credential Mode",
          "type": "string"
        },
        "credential_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Revision"
        },
        "allowed_tables": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Tables",
          "type": "array"
        },
        "allowed_columns": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Columns"
        },
        "capability_manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability Manifest"
        },
        "allow_fact_data": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Fact Data"
        },
        "include_hidden": {
          "default": false,
          "title": "Include Hidden",
          "type": "boolean"
        },
        "header_row": {
          "default": 1,
          "minimum": 1,
          "title": "Header Row",
          "type": "integer"
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Encoding"
        },
        "delimiter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delimiter"
        },
        "header": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header"
        },
        "null_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Null Values"
        },
        "type_inference": {
          "anyOf": [
            {
              "const": "text",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Inference"
        },
        "columns": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Columns"
        },
        "table_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Name"
        },
        "schema_name": {
          "default": "public",
          "title": "Schema Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "SourceConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_config": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Config"
    },
    "isolation_domain": {
      "default": "default",
      "title": "Isolation Domain",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "title": "Sources",
      "type": "array"
    },
    "documents": {
      "items": {
        "type": "string"
      },
      "title": "Documents",
      "type": "array"
    },
    "rules": {
      "items": {
        "type": "string"
      },
      "title": "Rules",
      "type": "array"
    },
    "goal": {
      "$ref": "#/$defs/ExtractionGoal"
    },
    "goal_markdown": {
      "anyOf": [
        {
          "maxLength": 64000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "User-authored Markdown construction objective. Null renders the legacy goal fields; source authorization remains in typed configuration.",
      "title": "Goal Markdown"
    },
    "limits": {
      "$ref": "#/$defs/QueryLimits"
    },
    "model": {
      "$ref": "#/$defs/ModelConfig"
    },
    "output_dir": {
      "default": "runs/default",
      "title": "Output Dir",
      "type": "string"
    },
    "record_trace": {
      "default": true,
      "description": "Record the complete local run trajectory with credentials redacted; retain until manually cleared.",
      "title": "Record Trace",
      "type": "boolean"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "title": "Scopes",
      "type": "array"
    },
    "scope_bindings": {
      "description": "Operator-owned source/table columns determining each result support scope. No binding means public; never inferred from identity keys.",
      "items": {
        "$ref": "#/$defs/GraphScopeBinding"
      },
      "maxItems": 1024,
      "title": "Scope Bindings",
      "type": "array"
    },
    "max_working_bytes": {
      "default": 33554432,
      "exclusiveMinimum": 0,
      "title": "Max Working Bytes",
      "type": "integer"
    },
    "max_db_queries": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Total source-query admissions, including metadata and transaction controls. Null removes only the query-count ceiling.",
      "title": "Max Db Queries"
    },
    "construction_target": {
      "default": "instances",
      "description": "Build concrete instance nodes and edges, or publish only structure and source mappings with no claim of instance validation.",
      "enum": [
        "instances",
        "structure"
      ],
      "title": "Construction Target",
      "type": "string"
    },
    "max_partitions": {
      "default": 256,
      "maximum": 4096,
      "minimum": 1,
      "title": "Max Partitions",
      "type": "integer"
    },
    "max_discovery_rounds": {
      "default": 3,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Discovery Rounds",
      "type": "integer"
    },
    "discovery_time_fraction": {
      "default": 0.75,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Discovery Time Fraction",
      "type": "number"
    },
    "discovery_query_fraction": {
      "default": 0.75,
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Discovery Query Fraction",
      "type": "number"
    },
    "max_relation_discovery_attempts": {
      "default": 2,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Relation Discovery Attempts",
      "type": "integer"
    },
    "max_reconciliation_entities": {
      "default": 5000,
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Reconciliation Entities",
      "type": "integer"
    },
    "max_reconciliation_candidates": {
      "default": 256,
      "maximum": 4096,
      "minimum": 1,
      "title": "Max Reconciliation Candidates",
      "type": "integer"
    },
    "max_identity_reviews": {
      "default": 8,
      "maximum": 64,
      "minimum": 0,
      "title": "Max Identity Reviews",
      "type": "integer"
    },
    "max_run_seconds": {
      "default": 1800,
      "exclusiveMinimum": 0,
      "title": "Max Run Seconds",
      "type": "number"
    },
    "deployment_retention_verified": {
      "default": false,
      "title": "Deployment Retention Verified",
      "type": "boolean"
    },
    "rediscover": {
      "default": false,
      "title": "Rediscover",
      "type": "boolean"
    },
    "document_scopes": {
      "items": {
        "type": "string"
      },
      "title": "Document Scopes",
      "type": "array"
    },
    "removed_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Removed Document Ids",
      "type": "array"
    },
    "removed_rule_ids": {
      "items": {
        "type": "string"
      },
      "title": "Removed Rule Ids",
      "type": "array"
    }
  },
  "required": [
