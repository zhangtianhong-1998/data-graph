{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LightGraph snapshot 1.0",
  "type": "object",
  "properties": {
    "format_version": {
      "const": "1.0"
    },
    "isolation_domain": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "fact_kind": {
                "const": "NodeExistence"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "entity_id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "AnalysisMethod",
                      "AnalysisQuestion",
                      "BusinessConcept",
                      "Column",
                      "ColumnGroup",
                      "Constraint",
                      "Database",
                      "Dimension",
                      "DimensionMember",
                      "Document",
                      "DocumentSection",
                      "GraphFact",
                      "Measure",
                      "Metric",
                      "ReportItem",
                      "Rule",
                      "Schema",
                      "SemanticSlot",
                      "Table",
                      "Workbook",
                      "Worksheet"
                    ]
                  },
                  "layer": {
                    "enum": [
                      "business",
                      "metadata",
                      "provenance"
                    ]
                  }
                },
                "required": [
                  "entity_id",
                  "kind",
                  "layer"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "accepted",
                  "candidate",
                  "unresolved"
                ]
              },
              "support_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "fact_kind",
              "payload",
              "status",
              "support_ids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "fact_kind": {
                "const": "PropertyValue"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "entity_id": {
                    "type": "string"
                  },
                  "name": {
                    "enum": [
                      "aggregation",
                      "alias",
                      "business_code",
                      "caliber",
                      "column",
                      "column_position",
                      "comment",
                      "coverage",
                      "data_type",
                      "definition",
                      "description",
                      "dimension",
                      "document_ref",
                      "domain",
                      "english_name",
                      "formula",
                      "frequency",
                      "granularity",
                      "kind",
                      "label",
                      "level",
                      "level_no",
                      "modality",
                      "name",
                      "normalization",
                      "nullable",
                      "period",
                      "primary_key",
                      "qualified_name",
                      "revision",
                      "role",
                      "rule_ref",
                      "schema",
                      "scope",
                      "section_ref",
                      "semantic_namespace",
                      "source_position",
                      "source_ref",
                      "table",
                      "target_kind",
                      "taxonomy",
                      "technical_status",
                      "unit"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "qualifiers": {
                    "type": "object",
                    "propertyNames": {
                      "enum": [
                        "allow_dag",
                        "caliber",
                        "column_position",
                        "condition",
                        "coverage",
                        "document_ref",
                        "formula",
                        "granularity",
                        "hierarchy_version",
                        "level",
                        "modality",
                        "namespace",
                        "normalization",
                        "period",
                        "relation_group",
                        "role",
                        "semantic_basis",
                        "semantic_level",
                        "source_group",
                        "source_level",
                        "target_level",
                        "taxonomy",
                        "technical_status",
                        "unit",
                        "valid_period"
                      ]
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "entity_id",
                  "name",
                  "value",
                  "qualifiers"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "accepted",
                  "candidate",
                  "unresolved"
                ]
              },
              "support_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "fact_kind",
              "payload",
              "status",
              "support_ids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "fact_kind": {
                "const": "Edge"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "relation": {
                    "enum": [
                      "analyzes",
                      "constraint_column",
                      "constraint_target",
                      "declared_fk",
                      "defined_by",
                      "documented_by",
                      "expresses_role",
                      "has_constraint",
                      "has_schema",
                      "has_section",
                      "has_sheet",
                      "has_table",
                      "maps_to_concept",
                      "member_of",
                      "member_of_group",
                      "parent_of",
                      "same_attribute_role",
                      "same_entity",
                      "sheet_has_column",
                      "supported_by_rule",
                      "table_has_column",
                      "technical_link",
                      "uses_measure",
                      "value_overlap",
                      "verified_reference"
                    ]
                  },
                  "target": {
                    "type": "string"
                  },
                  "qualifiers": {
                    "type": "object",
                    "propertyNames": {
                      "enum": [
                        "allow_dag",
                        "caliber",
                        "column_position",
                        "condition",
                        "coverage",
                        "document_ref",
                        "formula",
                        "granularity",
                        "hierarchy_version",
                        "level",
                        "modality",
                        "namespace",
                        "normalization",
                        "period",
                        "relation_group",
                        "role",
                        "semantic_basis",
                        "semantic_level",
                        "source_group",
                        "source_level",
                        "target_level",
                        "taxonomy",
                        "technical_status",
                        "unit",
                        "valid_period"
                      ]
                    },
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  }
                },
                "required": [
                  "source",
                  "relation",
                  "target",
                  "qualifiers"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "accepted",
                  "candidate",
                  "unresolved"
                ]
              },
              "support_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "fact_kind",
              "payload",
              "status",
              "support_ids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "fact_kind": {
                "const": "DocumentClaim"
              },
              "payload": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "predicate": {
                    "type": "string"
                  },
                  "object": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "modality": {
                    "enum": [
                      "asserted",
                      "possible",
                      "recommended",
                      "conditional",
                      "negated"
                    ]
                  },
                  "conditions": {
                    "type": "object",
                    "maxProperties": 16,
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "id",
                  "subject",
                  "predicate",
                  "object",
                  "modality",
                  "conditions"
                ],
                "additionalProperties": false
              },
              "status": {
                "enum": [
                  "accepted",
                  "candidate",
                  "unresolved"
                ]
              },
              "support_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "fact_kind",
              "payload",
              "status",
              "support_ids"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "supports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical": {
      "type": "boolean"
    },
    "semantic_schema": {
      "additionalProperties": false,
      "properties": {
        "entity_types": {
          "items": {
            "$ref": "#/$defs/EntityTypeDefinition"
          },
          "maxItems": 64,
          "title": "Entity Types",
          "type": "array"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyDefinition"
          },
          "maxItems": 256,
          "title": "Properties"
        },
        "relations": {
          "items": {
            "$ref": "#/$defs/RelationDefinition"
          },
          "maxItems": 128,
          "title": "Relations",
          "type": "array"
        }
      },
      "title": "SemanticSchema",
      "type": "object"
    }
  },
  "required": [
    "format_version",
    "isolation_domain",
    "scopes",
    "nodes",
    "edges",
    "claims",
    "facts",
    "supports",
    "publications",
    "historical"
  ],
  "additionalProperties": false,
  "$defs": {
    "EntityTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "EntityTypeDefinition",
      "type": "object"
    },
    "PropertyDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "value_type": {
          "default": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "entity_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Entity Kinds",
          "type": "array"
        },
        "multi_valued": {
          "default": false,
          "title": "Multi Valued",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "description",
        "entity_kinds"
      ],
      "title": "PropertyDefinition",
      "type": "object"
    },
    "RelationDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Source Kinds",
          "type": "array"
        },
        "target_kinds": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Target Kinds",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "source_kinds",
        "target_kinds"
      ],
      "title": "RelationDefinition",
      "type": "object"
    }
  }
}