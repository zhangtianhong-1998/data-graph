          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polymorphic By"
        },
        "require_full_coverage": {
          "default": false,
          "title": "Require Full Coverage",
          "type": "boolean"
        },
        "normalization": {
          "const": "identity",
          "default": "identity",
