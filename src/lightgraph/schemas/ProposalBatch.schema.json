    "Reference": {
      "additionalProperties": false,
      "properties": {
        "source_entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Verified source entity rule ID from entity_bindings.",
          "title": "Source Entity"
        },
        "source_columns": {
          "description": "Issued column IDs on the CURRENT table, ordered to match source_entity key_columns.",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Columns",
          "type": "array"
        },
        "target_entity": {
          "title": "Target Entity",
          "type": "string"
        },
        "source_level": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required selected level for a wide-hierarchy source binding; omit for ordinary groups and long hierarchies.",
          "title": "Source Level"
        },
        "target_level": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required selected level for a wide-hierarchy target binding; omit for ordinary groups and long hierarchies.",
          "title": "Target Level"
        },
        "target_columns": {
          "description": "Issued foreign-key column IDs on the CURRENT table, ordered to match target_entity key_columns. Do not use remote-table IDs.",
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Target Columns",
          "type": "array"
        },
        "direction": {
          "const": "source_to_target",
          "default": "source_to_target",
          "title": "Direction",
          "type": "string"
