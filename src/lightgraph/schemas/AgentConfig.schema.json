{
  "$defs": {
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "disabled",
          "enum": [
            "disabled",
            "metadata_only",
            "in_environment",
            "approved_external"
          ],
          "title": "Mode",
          "type": "string"
        },
        "base_url": {
          "default": "",
          "title": "Base Url",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "response_format": {
          "default": "json_schema",
          "enum": [
            "json_schema",
            "json_object"
          ],
          "title": "Response Format",
          "type": "string"
        },
        "api_key": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Key"
        },
        "api_key_env": {
          "default": "LIGHTGRAPH_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "stream": {
          "default": false,
          "title": "Stream",
          "type": "boolean"
        },
        "stream_options_include_usage": {
          "default": true,
          "title": "Stream Options Include Usage",
          "type": "boolean"
        },
        "allow_insecure_http": {
          "default": false,
          "title": "Allow Insecure Http",
          "type": "boolean"
        },
        "max_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 2000,
          "title": "Max Calls"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy cumulative-token setting retained for configuration migration; Harness budgets physical calls and wall time.",
          "title": "Max Tokens"
        },
        "max_discovery_steps": {
          "default": 16,
          "description": "Legacy per-table setting, accepted when reading old configurations; not used by Harness.",
          "maximum": 32,
          "minimum": 1,
          "title": "Max Discovery Steps",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 16,
          "description": "Legacy source-tool allowance; not used by Harness.",
          "maximum": 64,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 800,
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_tokens": {
          "default": 65536,
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_prompt_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy request-byte guard retained for configuration migration; not applied by Harness.",
          "title": "Max Prompt Bytes"
        },
        "max_prompt_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 1048576,
          "description": "Optional estimated input token cap, including tool schemas; independent of byte limits.",
          "title": "Max Prompt Tokens"
        },
        "context_window_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional combined input/output token window; max_output_tokens is reserved from it.",
          "title": "Context Window Tokens"
        },
        "working_context_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 32768,
          "description": "Harness working-context target; null disables automatic compaction including overflow recovery. Token-meter estimates are calibrated from provider usage.",
          "title": "Working Context Tokens"
        },
        "max_response_bytes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Legacy response-byte guard retained for configuration migration; not applied by Harness.",
          "title": "Max Response Bytes"
        },
        "retries": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Harness configuration; old framework names migrate, never select an old engine.",
  "properties": {
    "framework": {
      "const": "deepseek_harness",
      "default": "deepseek_harness",
      "title": "Framework",
      "type": "string"
    },
    "name": {
      "default": "lightgraph-discovery",
      "maxLength": 64,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "llm": {
      "$ref": "#/$defs/ModelConfig"
    }
  },
  "required": [
    "llm"
  ],
  "title": "AgentConfig",
  "type": "object"
}